{
  "name": "create-dacs-agent",
  "version": "0.1.0-alpha.0",
  "description": "Create bounded offline or guarded live DACS agent projects.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DACS-Agent-commerce/dacs-sdk.git",
    "directory": "packages/create-dacs-agent"
  },
  "homepage": "https://github.com/DACS-Agent-commerce/dacs-sdk/tree/main/packages/create-dacs-agent#readme",
  "bugs": {
    "url": "https://github.com/DACS-Agent-commerce/dacs-sdk/issues"
  },
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "bin": {
    "create-dacs-agent": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dacs": {
