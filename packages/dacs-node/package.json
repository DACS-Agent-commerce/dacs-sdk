{
  "name": "@kynesyslabs/dacs-node",
  "version": "0.1.0-alpha.0",
  "description": "Production Node.js host contracts and adapters for the DACS SDK.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DACS-Agent-commerce/dacs-sdk.git",
    "directory": "packages/dacs-node"
  },
  "homepage": "https://github.com/DACS-Agent-commerce/dacs-sdk/tree/main/packages/dacs-node#readme",
  "bugs": {
    "url": "https://github.com/DACS-Agent-commerce/dacs-sdk/issues"
  },
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./transport": {
      "types": "./dist/transport/index.d.ts",
      "import": "./dist/transport/index.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js"
    },
    "./vectors/dacs-http-envelope-v1.json": "./vectors/dacs-http-envelope-v1.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "vectors",
    "README.md",
    "LICENSE"
  ],
  "dacs": {
    "releaseMetadataVersion": 1,
    "standardRevision": "965df755aba4ff392f1fb37a93d287242b177ba4",
    "configSchemaVersion": 1,
    "sqliteSchemaVersion": 7,
    "supportedSqliteMigrationFrom": [1, 2, 3, 4, 5, 6, 7],
    "breakingConfigurationChanges": []
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:with-core": "npm --prefix ../.. run build && npm run build",
    "prepack": "npm run clean && npm run build:with-core",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "vectors:generate": "npm run build:with-core && node scripts/generate-envelope-vectors.mjs",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build:with-core"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@kynesyslabs/dacs": "0.1.0-alpha.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "12.6.2"
  },
  "devDependencies": {
    "@kynesyslabs/dacs": "file:../..",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^20",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
