{
  "name": "@kynesyslabs/dacs",
  "version": "0.1.0-alpha.0",
  "description": "TypeScript SDK for building DACS (Demos Agent Commerce Standards) agents — the reusable runtime for the Identify → Vet → Negotiate → Settle → Verify lifecycle.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DACS-Agent-commerce/dacs-sdk.git"
  },
  "homepage": "https://github.com/DACS-Agent-commerce/dacs-sdk#readme",
  "bugs": {
    "url": "https://github.com/DACS-Agent-commerce/dacs-sdk/issues"
  },
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./canonical": {
      "types": "./dist/canonical/index.d.ts",
      "import": "./dist/canonical/index.js"
    },
    "./crypto": {
      "types": "./dist/crypto/index.d.ts",
      "import": "./dist/crypto/index.js"
    },
    "./artifacts": {
      "types": "./dist/artifacts/index.d.ts",
      "import": "./dist/artifacts/index.js"
    },
    "./identity": {
      "types": "./dist/identity/index.d.ts",
      "import": "./dist/identity/index.js"
    },
    "./discovery": {
      "types": "./dist/discovery/index.d.ts",
      "import": "./dist/discovery/index.js"
    },
    "./negotiate": {
      "types": "./dist/negotiate/index.d.ts",
      "import": "./dist/negotiate/index.js"
    },
    "./rails": {
      "types": "./dist/rails/index.d.ts",
      "import": "./dist/rails/index.js"
    },
    "./seller": {
      "types": "./dist/seller/index.d.ts",
      "import": "./dist/seller/index.js"
    },
    "./commerce": {
      "types": "./dist/commerce/index.d.ts",
      "import": "./dist/commerce/index.js"
    },
    "./registry": {
      "types": "./dist/registry/index.d.ts",
      "import": "./dist/registry/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    },
    "./substrate": {
      "types": "./dist/substrate/index.d.ts",
      "import": "./dist/substrate/index.js"
    }
  },
  "bin": {
    "dacs": "./dist/bin/dacs.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "docs/parser-engine.md",
    "docs/alternative-payment-projection.md",
    "docs/demos-cci-identities.md",
    "docs/fixed-price-offline-coordinator.md",
    "docs/fixed-price-x402-coordinator.md",
    "docs/rfq-negotiation-core.md",
    "docs/settlement-verified-reputation.md",
    "docs/pay-ap2.md",
    "docs/pay-solana-spl.md",
    "docs/pay-cross-chain-htlc.md",
    "docs/pay-cross-chain-liquidity-tank.md",
    "docs/x402-seller-paywall.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "host:build": "npm run build --workspace @kynesyslabs/dacs-node",
    "generator:build": "npm run build --workspace create-dacs-agent",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.examples.json",
    "host:typecheck": "npm run typecheck --workspace @kynesyslabs/dacs-node",
    "generator:typecheck": "npm run typecheck --workspace create-dacs-agent",
    "test": "vitest run",
    "host:test": "npm test --workspace @kynesyslabs/dacs-node",
    "generator:test": "npm test --workspace create-dacs-agent",
    "test:live": "vitest run test/integration/live.e2e.test.ts",
    "test:live:pay-dem": "vitest run test/integration/pay-dem-two-agent.live.test.ts",
    "test:watch": "vitest",
    "conformance:sync": "node scripts/sync-vectors.mjs",
    "clean": "rm -rf dist",
    "prepack": "npm run clean && npm run build",
    "package:verify": "node scripts/verify-package.mjs",
    "package:lifecycle:verify": "node scripts/verify-package-lifecycle.mjs",
    "release:set:verify": "node scripts/verify-release-set.mjs",
    "release:set:publish": "node scripts/publish-release-set.mjs",
    "acceptance:registry-container": "bash scripts/verify-registry-container-consumer.sh"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@swaggerexpert/jsonpath": "4.0.4",
    "@xmldom/xmldom": "^0.9.12",
    "css-select": "^7.0.0",
    "htmlparser2": "^12.0.0",
    "re2-wasm": "^1.0.2",
    "xpath": "^0.0.34"
  },
  "dacs": {
    "releaseMetadataVersion": 1,
    "standardRevision": "741057bf26509ca2701ee78171e6049b1bc665b4",
    "configSchemaVersion": 1,
    "sqliteSchemaVersion": 7,
    "supportedSqliteMigrationFrom": [1, 2, 3, 4, 5, 6, 7],
    "breakingConfigurationChanges": []
  },
  "peerDependencies": {
    "@kynesyslabs/demosdk": "^4.0.16",
    "@x402/core": "^2.15.0",
    "@x402/evm": "^2.15.0",
    "@x402/fetch": "^2.15.0",
    "viem": "^2.55.19"
  },
  "peerDependenciesMeta": {
    "@kynesyslabs/demosdk": { "optional": true },
    "@x402/core": { "optional": true },
    "@x402/evm": { "optional": true },
    "@x402/fetch": { "optional": true },
    "viem": { "optional": true }
  },
  "devDependencies": {
    "@kynesyslabs/demosdk": "^4.0.16",
    "@types/node": "^20",
    "@x402/core": "^2.15.0",
    "@x402/evm": "^2.15.0",
    "@x402/fetch": "^2.15.0",
    "ganache": "7.9.2",
    "typescript": "^5",
    "viem": "^2.55.19",
    "vitest": "^4.0.18"
  }
}
